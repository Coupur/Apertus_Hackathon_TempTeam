# Copy to .env and fill in. Never commit .env.

# LLM provider: auto (default) = Apertus if LLM_* set → local Ollama app → Kimi API key
# LLM_PROVIDER=auto        # apertus | ollama | kimi | auto

# Option A — Ollama (preferred when the app is running). Use a FREE local model.
#   ollama pull qwen2.5:7b
# Cloud models like kimi-k2.6:cloud need paid Ollama credits (HTTP 402) — avoid for demos.
OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_THINK=0                 # keep off for local models (faster + better JSON)
# OLLAMA_TIMEOUT_S=300
# If a cloud model 402s, the client auto-retries with an installed local model.

# Option B — Apertus (the challenge's required model family), OpenAI-compatible endpoint
LLM_NAME=
LLM_BASE_URL=
LLM_API_KEY=

# Optional switches (defaults shown)
# LLM_PROFILE=1           # 0 = skip the LLM medical profile (rules only)
# LLM_PROFILE_NAME_SEED=0 # 1 = heavy JSON profile even for name-only (slow on local 7B)
# FAST_WEB_SNIPPET=0      # 1 = name-only uses Wikipedia snippet, no LLM rewrite (fastest)
# KIMI_SUMMARY=1           # short LLM rewrite of pages; skipped inside enrich when profile runs
# WIKIDATA_LOOKUP=1        # 0 = no Wikidata HQ lookup (verified, linked)
# LLM_BACKGROUND_FACTS=1   # 0 = never show model-knowledge HQ (flagged unverified)
# WEB_ENRICH=0            # 1 = always search by company name (offline default = off)
#                         # Name-only seeds (e.g. "Mindray") always force a web search.
# OLLAMA_SUMMARY_TIMEOUT_S=90
# OLLAMA_PROFILE_TIMEOUT_S=120
# BERN_RECORDS_PATH=      # teammate Bern records file/folder (default src/company_match/data/bern_records/)
# ALLOW_LOCAL_PATHS=0     # 1 = POST /ingest may read server-local file paths (local dev only)
# ALLOW_PRIVATE_URLS=0    # 1 = allow fetching localhost / private-network URLs

# Fallback summary model, only used when no Apertus endpoint is set
# Kimi / Moonshot — PDF company summary layer (kimi-k2.6)
KIMI_API_KEY=
# Alias also accepted:
# MOONSHOT_API_KEY=

# Optional overrides
# KIMI_BASE_URL=https://api.moonshot.ai/v1
# KIMI_MODEL=kimi-k2.6
# KIMI_TIMEOUT_S=90

# Focused company-report model; defaults to LLM_NAME when left unset.
REPORT_LLM_NAME=apertus-v1-5-70b
# Example Apertus gateway settings:
# LLM_BASE_URL=https://gateway.keera.ch/api/v1
# LLM_NAME=apertus-v1-5-8b
